# --- Speech-to-text (streaming) --- get a free key at https://console.deepgram.com
DEEPGRAM_API_KEY=

# --- Text-to-speech (streaming) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=SOYHLrjzK2X1ezoPC6cr
ELEVENLABS_MODEL=eleven_flash_v2_5

# Optional: per-language voices (pick free voice IDs from the ElevenLabs library).
# Leave empty to reuse ELEVENLABS_VOICE_ID — flash v2.5 is multilingual, so the
# default voice speaks all supported languages with the right accent.
ELEVENLABS_VOICE_ID_AR=
ELEVENLABS_VOICE_ID_RU=
ELEVENLABS_VOICE_ID_ES=
ELEVENLABS_VOICE_ID_PT=

# --- LLM via OpenRouter ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
